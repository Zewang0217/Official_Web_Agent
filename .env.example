# ===== 后端(Official_Web_Backend)=====
BACKEND_BASE_URL=http://localhost:8080
# 专用服务账号(SEC-01,后端侧创建,最小权限)
BACKEND_SERVICE_USERNAME=
BACKEND_SERVICE_PASSWORD=

# ===== 模型 =====
ANTHROPIC_API_KEY=
# 分级路由:轻量任务(意图分类/抽取)与推理任务(评估/合成)
MODEL_LIGHT=claude-haiku-4-5-20251001
MODEL_STRONG=claude-sonnet-5

# ===== 状态与记忆(ADR-0007:checkpointer 与长期记忆均用 Postgres)=====
POSTGRES_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/official_agent

# ===== 运行时上下文(M6 #114,冷配置:改动需重启)=====
# 会话超阈值触发压缩(checkpoint 内消息的 tiktoken 计数,不含 system/工具)
CONTEXT_COMPRESS_THRESHOLD_TOKENS=24000
# 压缩后保留的近几轮原始消息条数
CONTEXT_RECENT_KEEP_MESSAGES=12

# ===== 飞书(M3)=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ===== 观测 =====
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

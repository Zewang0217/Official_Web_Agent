# 生产密钥模板(cp .env.prod 后填值;gitignore,SEC-01 真实凭证只进服务器)
# Agent 服务自身的全部配置经 env 注入,不进镜像。

# ── compose 编排 ──
AGENT_PG_PASSWORD=change_me
AGENT_VERSION=latest
DOCKERHUB_USERNAME=boyuanclub

# ── Agent 应用(compose 注入,勿重复)──
BACKEND_BASE_URL=https://official.boyuan.club

# ── LLM(现网在用哪家填哪家)──
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
MODEL_STRONG=deepseek-chat
MODEL_LIGHT=

# ── 后端服务账号(SEC-01,agent 调官网 API 用)──
BACKEND_SERVICE_USERNAME=
BACKEND_SERVICE_PASSWORD=

# ── 观测(自托管 langfuse 已有则填;缺省 fail-open)──
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
